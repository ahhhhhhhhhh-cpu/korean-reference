# Korean Reference — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or real secrets to Git.

# =============================================================================
# Application
# =============================================================================

# Public site URL (used for SEO canonical, OG tags)
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" during Demo phase to use local Mock data.
# Set to "false" for Production MVP with Supabase.
USE_MOCK_DATA=true

# =============================================================================
# Supabase
# =============================================================================

# Supabase project URL
# Found in: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous (public) key — safe for browser, subject to RLS
# Found in: Supabase Dashboard → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY, bypasses RLS
# Found in: Supabase Dashboard → Settings → API → service_role
# WARNING: Never expose this to the browser or commit to Git
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Optional — Future Use
# =============================================================================

# Cloudflare Turnstile (if spam becomes an issue)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Custom domain override (if different from NEXT_PUBLIC_SITE_URL)
# NEXT_PUBLIC_CANONICAL_URL=
