# Korean Reference — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or real secrets to Git.

# =============================================================================
# Application
# =============================================================================

# Public site URL (used for SEO canonical, OG tags)
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" during Demo phase to use local Mock data.
# Set to "false" for local Supabase adapter (requires local stack).
USE_MOCK_DATA=true

# Explicit override: mock | supabase (takes precedence over USE_MOCK_DATA)
# DATA_SOURCE=mock

# =============================================================================
# Supabase
# =============================================================================

# Supabase project URL
# Found in: Supabase Dashboard → Connect or Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (preferred) — low-privilege, safe for browser, subject to RLS
# Found in: Supabase Dashboard → Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon key — local Supabase CLI only (npx supabase status)
# Remote dev should use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret / service_role key — SERVER ONLY, bypasses RLS. NOT used in Phase 6D.
# WARNING: Never expose to browser, NEXT_PUBLIC_*, or Git
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Optional — Future Use
# =============================================================================

# Cloudflare Turnstile (if spam becomes an issue)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Custom domain override (if different from NEXT_PUBLIC_SITE_URL)
# NEXT_PUBLIC_CANONICAL_URL=
